# Copy to a private .env in your deployment; never commit populated secrets.
DATABASE_URL=postgresql://user:password@localhost:5432/neobrain
PORT=8080
NODE_ENV=development
APP_ORIGIN=http://localhost:8080
BASE_PATH=/
API_PROXY_TARGET=http://localhost:8080
# Frontend build is served by API server; optional override:
# FRONTEND_DIR=/absolute/path/to/artifacts/accentecx/dist/public
# Required for production email verification, invitations and password reset:
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Durable private storage, outside any public/static directory:
PRIVATE_UPLOAD_DIR=/private/neobrain/uploads
# 32-byte AES key encoded as exactly 64 hex characters; preserve it in a vault.
FILE_ENCRYPTION_KEY=
# Start with test credentials. Never put these in frontend variables.
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_PAYMENT_METHODS=card,gcash,paymaya,qrph
# Set true only after the merchant/provider collection arrangement is enabled.
PAYMONGO_PROVIDER_COLLECTION_APPROVED=false
# Contracted monthly organization price, integer PHP centavos:
ORGANIZATION_MONTHLY_FEE_CENTAVOS=
